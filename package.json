{
  "name": "gold-miner-storybook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A storybook-styled Gold Miner browser game, built with TypeScript and Phaser.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run typecheck && npm run test && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "session:export": "node scripts/export-session.mjs"
  },
  "dependencies": { "phaser": "3.90.0" },
  "devDependencies": { "typescript": "5.9.3", "vite": "8.3.4" },
  "engines": { "node": ">=22.18.0" }
}
