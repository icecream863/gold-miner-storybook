```js
await (async (page) => {
  const checks = [];
  const check = (name, pass, detail = '') => { checks.push({ name, pass: Boolean(pass), detail }); if (!pass) throw new Error(JSON.stringify(checks)); };
  const state = () => page.evaluate(() => window.__goldMiner);
  const errors = [];
  page.on('pageerror', e => errors.push(e.message));
  try { await page.clock.resume(); } catch { /* 首次运行尚未安装虚拟时钟。 */ }
  await page.setViewportSize({ width: 1440, height: 1000 });
  await page.goto('http://127.0.0.1:5173/?qa=1');
  await page.waitForFunction(() => !!window.__goldMiner);
  await page.getByRole('button', { name: '开始寻金', exact: true }).waitFor();
  check('首页加载与标题', (await page.title()).includes('矿山手记'));
  await page.screenshot({ path: 'output/playwright/desktop-menu.png', fullPage: true });
  await page.clock.install();
  await page.getByRole('button', { name: '开始寻金', exact: true }).click();
  check('开始第一关', (await state()).phase === 'playing' && (await state()).level === 0);
  await page.clock.runFor(1000);
  const before = await state();
  check('倒计时与摆动在运行', before.remaining < 60 && before.hook === 'swinging');
  await page.keyboard.press('Space');
  await page.clock.runFor(100);
  check('空格触发发射', (await state()).hook === 'extending');
  await page.keyboard.press('P');
  const paused = await state();
  await page.clock.runFor(5000);
  const frozen = await state();
  check('暂停冻结时间与钩爪', frozen.phase === 'paused' && frozen.remaining === paused.remaining && frozen.length === paused.length);
  await page.getByRole('button', { name: '翻翻玩法手记' }).click();
  check('暂停时可以打开帮助', await page.getByRole('heading', { name: '出发前，翻翻手记' }).isVisible());
  await page.getByRole('button', { name: '返回暂停界面' }).click();
  await page.getByRole('button', { name: '继续寻金' }).click();
  await page.clock.runFor(1200);
  check('恢复后继续运动', (await state()).phase === 'playing' && (await state()).remaining < frozen.remaining);
  await page.getByRole('button', { name: '静音', exact: true }).click();
  check('静音按钮状态', await page.getByRole('button', { name: '开启声音', exact: true }).isVisible());
  await page.getByRole('button', { name: '开启声音', exact: true }).click();
  await page.screenshot({ path: 'output/playwright/desktop-playing.png', fullPage: true });
  await page.evaluate(() => window.dispatchEvent(new Event('blur')));
  check('失焦监听触发暂停', (await state()).phase === 'paused');
  await page.getByRole('button', { name: '返回首页', exact: true }).click();
  await page.getByRole('button', { name: '开始寻金', exact: true }).click();
  await page.clock.runFor(61000);
  check('不抓取会失败结算', (await state()).phase === 'result' && (await state()).money === 0);
  await page.getByRole('button', { name: /^再试一次/ }).click();
  const retried = await state();
  check('失败重试恢复入口', retried.phase === 'playing' && retried.money === 0 && retried.bombs === 1 && retried.items.every(i => !i.taken));
  await page.keyboard.press('P');
  await page.getByRole('button', { name: '返回首页', exact: true }).click();
  await page.setViewportSize({ width: 390, height: 844 });
  await page.clock.runFor(200);
  const mobileBounds = await page.evaluate(() => ({ scroll: document.documentElement.scrollWidth, width: innerWidth, button: document.querySelector('[data-action="start"]').getBoundingClientRect().toJSON() }));
  check('手机窄屏无水平溢出', mobileBounds.scroll <= mobileBounds.width);
  check('手机开始按钮可见', mobileBounds.button.x >= 0 && mobileBounds.button.right <= 390);
  await page.screenshot({ path: 'output/playwright/mobile-menu.png', fullPage: true });
  await page.getByRole('button', { name: '开始寻金', exact: true }).click();
  await page.clock.runFor(100);
  const canvas = page.locator('canvas');
  const box = await canvas.boundingBox();
  await page.mouse.click(box.x + box.width * .5, box.y + box.height * .6);
  await page.clock.runFor(100);
  check('缩放后点击画布仍可出钩', (await state()).hook !== 'swinging');
  await page.keyboard.press('P');
  await page.getByRole('button', { name: '返回首页', exact: true }).click();
  await page.setViewportSize({ width: 844, height: 390 });
  await page.clock.runFor(200);
  await page.screenshot({ path: 'output/playwright/mobile-landscape.png', fullPage: true });
  check('横屏开始按钮仍可操作', await page.getByRole('button', { name: '开始寻金', exact: true }).isVisible());
  await page.setViewportSize({ width: 1280, height: 720 });
  await page.clock.runFor(200);
  const desktop = await page.evaluate(() => ({ frame: document.querySelector('.frame').getBoundingClientRect().toJSON(), height: innerHeight }));
  check('720p 窗口完整容纳游戏区域', desktop.frame.bottom <= desktop.height);
  check('浏览器脚本无异常', errors.length === 0, errors.join('; '));
  await page.clock.resume();
  return { checks, total: checks.length, passed: checks.filter(c => c.pass).length, errors };
}
)(page);
